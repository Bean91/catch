# Pi deployment env — lives at /var/lib/catch/catch.env (mode 600, owned by the `catch`
# user), loaded by systemd's EnvironmentFile=, never rsynced as part of a deploy. Fill in
# the same real values your laptop's .env already has (Garmin key, Withings app creds,
# Concept2 token, password hash, session secret) — the three secrets below (password hash,
# session secret, Fernet key) should be the SAME values as your laptop's .env if you copied
# the real DB over, since the Fernet key in particular decrypts tokens already stored in it.
#
# Differences from .env.example, all required on the Pi:
#   - CATCH_ENV=production
#   - CATCH_DB_PATH is an absolute path outside the code directory, so a redeploy's
#     `rsync --delete` of /opt/catch/app can never touch it.
#   - CATCH_BASE_URL / WITHINGS_REDIRECT_URI point at the Tailscale HTTPS hostname, not
#     localhost — see docs/withings-endpoints.md for re-registering the callback.

CATCH_ENV=production
CATCH_PORT=8000
CATCH_DB_PATH=/var/lib/catch/catch.db
CATCH_BASE_URL=https://<pi-name>.<tailnet>.ts.net

CATCH_PASSWORD_HASH=
CATCH_SESSION_SECRET=
CATCH_FERNET_KEY=

GARMIN_PERSONAL_API_KEY=
GARMIN_KEY_EXPIRES=

WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=
WITHINGS_REDIRECT_URI=https://<pi-name>.<tailnet>.ts.net/auth/withings/callback

CONCEPT2_ACCESS_TOKEN=

SYNC_INTERVAL_HOURS=2
BACKFILL_DAYS=30

CATCH_MCP_HTTP_ENABLED=0
