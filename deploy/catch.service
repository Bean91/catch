[Unit]
Description=Catch — self-hosted rowing training app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=catch
Group=catch
WorkingDirectory=/opt/catch/app
EnvironmentFile=/var/lib/catch/catch.env
ExecStart=/opt/catch/app/.venv/bin/uvicorn catch.main:app \
    --host 127.0.0.1 --port 8000 --workers 1 \
    --no-access-log --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5

# PiAware (piaware/fr24feed/dump1090/tar1090) shares this box and always wins: lowest
# scheduling priority and idle-class disk I/O so a sync or a coach turn never steals a
# cycle ADS-B needed, and a hard memory ceiling so a leak can't pressure the box into swap.
Nice=10
IOSchedulingClass=idle
MemoryMax=300M

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/catch

[Install]
WantedBy=multi-user.target
