# Native (Capacitor) build, "staging" environment. Copy to .env.native-staging.local (gitignored) and fill in, then:
#   npm run build:native -- --mode native-staging     (or: CATCH_NATIVE_ENV=staging npm run native:sync)
# A separate staging deployment + Supabase project, if you run one. Installs beside production (app id suffix .staging).
# Only PUBLIC values ever go here: they are compiled into an app anyone can download and unpack.
# Never the Supabase secret key, a database URL, an APNs/FCM key or a signing key (vite.config.ts and scripts/check-build-secrets.mjs refuse).
VITE_CATCH_DEPLOYMENT=public
VITE_CATCH_NATIVE=1
VITE_SUPABASE_URL=https://YOUR-STAGING-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_BASE_URL=https://staging.example.com
VITE_WEB_BASE_URL=https://staging.example.com
