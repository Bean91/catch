# Native (Capacitor) build, "development" environment. Copy to .env.native-development.local (gitignored) and fill in, then:
#   npm run build:native -- --mode native-development     (or: CATCH_NATIVE_ENV=development npm run native:sync)
# Local: the API from 'uv run uvicorn' with CATCH_DEPLOYMENT=public and the throwaway Supabase stack (npx supabase start in ~/supabase-catch-test). Android emulator: adb reverse tcp:8000 tcp:8000 tcp:54321 tcp:54321.
# Only PUBLIC values ever go here: they are compiled into an app anyone can download and unpack.
# Never the Supabase secret key, a database URL, an APNs/FCM key or a signing key (vite.config.ts and scripts/check-build-secrets.mjs refuse).
VITE_CATCH_DEPLOYMENT=public
VITE_CATCH_NATIVE=1
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_BASE_URL=http://localhost:8000
VITE_WEB_BASE_URL=http://localhost:8000
