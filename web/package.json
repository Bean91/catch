{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "preview": "vite preview",
    "preview:test": "vite preview --port 5190 --strictPort",
    "test": "vitest run",
    "test:touch": "playwright test",
    "test:update": "playwright test -c playwright.update.config.ts",
    "test:gym": "playwright test -c playwright.gym.config.ts",
    "test:public": "playwright test -c playwright.public.config.ts",
    "test:live": "playwright test -c playwright.live.config.ts",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "check:build-secrets": "node scripts/check-build-secrets.mjs",
    "build:native": "tsc -b && vite build",
    "native:sync": "node scripts/native-config.mjs && npm run build:native -- --mode native-${CATCH_NATIVE_ENV:-production} && cap sync",
    "native:ios": "npm run native:sync && cap open ios",
    "native:android": "npm run native:sync && cap open android",
    "native:assets": "npx capacitor-assets generate --ios --android --iconBackgroundColor '#0B1120' --splashBackgroundColor '#0B1120'",
    "check:native-secrets": "node scripts/check-build-secrets.mjs dist-native ios/App/App/public android/app/src/main/assets/public",
    "cap": "node scripts/native-config.mjs && cap"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capgo/capacitor-health": "^8.13.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@supabase/auth-js": "^2.119.0",
    "@tanstack/react-query": "^5.105.0",
    "barcode-detector": "^3.2.3",
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "1.9",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "5.0.5"
  }
}
