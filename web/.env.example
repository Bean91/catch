# Build-time settings for the PUBLIC frontend (`VITE_CATCH_DEPLOYMENT=public npm run build`). A personal build sets none of
# these, and the Supabase auth client is then not even part of the bundle.
VITE_CATCH_DEPLOYMENT=public
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The PUBLISHABLE key only (sb_publishable_…). The secret key and database credentials never reach the browser.
VITE_SUPABASE_PUBLISHABLE_KEY=
