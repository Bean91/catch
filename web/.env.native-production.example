# Native (Capacitor) build, "production" environment. Copy to .env.native-production.local (gitignored) and fill in, then:
#   npm run build:native -- --mode native-production     (or: CATCH_NATIVE_ENV=production npm run native:sync)
# The production deployment. The Supabase project is the SAME one the web app uses, so web and native share accounts.
# Only PUBLIC values ever go here: they are compiled into an app anyone can download and unpack.
# Never the Supabase secret key, a database URL, an APNs/FCM key or a signing key (vite.config.ts and scripts/check-build-secrets.mjs refuse).
VITE_CATCH_DEPLOYMENT=public
VITE_CATCH_NATIVE=1
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_BASE_URL=https://catch.openoted.com
VITE_WEB_BASE_URL=https://catch.openoted.com
