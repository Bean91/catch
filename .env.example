# Copy to .env and fill in. Never commit .env.

CATCH_ENV=development
CATCH_PORT=8000
CATCH_DB_PATH=data/catch.db
CATCH_BASE_URL=http://localhost:8000

# argon2id hash of your login password: python -c "from argon2 import PasswordHasher; print(PasswordHasher().hash('yourpassword'))"
CATCH_PASSWORD_HASH=
# random secret for signing session cookies: python -c "import secrets; print(secrets.token_hex(32))"
CATCH_SESSION_SECRET=
# Fernet key for encrypting stored OAuth tokens: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CATCH_FERNET_KEY=

# Garmin Connect Personal API key (from developer.garmin.com), exchanged for a bearer token
GARMIN_PERSONAL_API_KEY=
# ISO date the key expires, for your own tracking — not read by the app. (Settings ->
# "Garmin personal API key expires on" is the one the app actually reads, for the in-app
# expiry banner — set it there, not here, since it's a UI-editable reminder, not an env var.)
GARMIN_KEY_EXPIRES=

# Withings OAuth2 app credentials (developer.withings.com)
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=
WITHINGS_REDIRECT_URI=http://localhost:8000/auth/withings/callback

# Concept2 Logbook long-lived personal access token: log in at log.concept2.com, then
# Edit Profile > Applications > Concept2 Logbook API integration > generate a token.
CONCEPT2_ACCESS_TOKEN=

SYNC_INTERVAL_HOURS=2
BACKFILL_DAYS=30

# Mounts the MCP server's streamable-HTTP transport at /mcp/ (trailing slash required — see
# docs/mcp.md), for reaching the coach's tools over Tailscale without stdio. Off by default:
# the `mcp` package is only imported when this is "1", so a Pi that never uses it pays nothing.
# The stdio transport (catch-mcp, for Claude Desktop) doesn't need this — see docs/mcp.md.
CATCH_MCP_HTTP_ENABLED=0

# USDA FoodData Central API key (free, self-serve: https://fdc.nal.usda.gov/api-key-signup) —
# used as the nutrition barcode-lookup fallback when Open Food Facts has no match. Without
# this set, barcode lookups go straight from Open Food Facts to manual entry — see
# docs/nutrition-endpoints.md.
USDA_FDC_API_KEY=
