# Copy to .env and fill in. Never commit .env.

CATCH_ENV=development
CATCH_PORT=8000
CATCH_DB_PATH=data/catch.db
CATCH_BASE_URL=http://localhost:8000

# argon2id hash of your login password: python -c "from argon2 import PasswordHasher; print(PasswordHasher().hash('yourpassword'))"
CATCH_PASSWORD_HASH=
# random secret for signing session cookies: python -c "import secrets; print(secrets.token_hex(32))"
CATCH_SESSION_SECRET=
# Fernet key for encrypting stored OAuth tokens: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CATCH_FERNET_KEY=

# Garmin Connect Personal API key (from developer.garmin.com), exchanged for a bearer token
GARMIN_PERSONAL_API_KEY=
# ISO date the key expires, for your own tracking — not read by the app. (Settings ->
# "Garmin personal API key expires on" is the one the app actually reads, for the in-app
# expiry banner — set it there, not here, since it's a UI-editable reminder, not an env var.)
GARMIN_KEY_EXPIRES=

# Withings OAuth2 app credentials (developer.withings.com)
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=
WITHINGS_REDIRECT_URI=http://localhost:8000/auth/withings/callback

# Concept2 Logbook long-lived personal access token: log in at log.concept2.com, then
# Edit Profile > Applications > Concept2 Logbook API integration > generate a token.
CONCEPT2_ACCESS_TOKEN=

# Whoop (session 23 — docs/whoop-endpoints.md): create an app at developer.whoop.com and register the
# redirect URI there exactly. Leave blank to keep Whoop off.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:8000/auth/whoop/callback

# Master secret for per-user AI provider keys (docs/security.md). Optional on the Pi: unset, it falls back
# to CATCH_FERNET_KEY. A public deployment must set its own, from its secret manager, never the database.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
CATCH_SECRETS_MASTER_KEY=
# IMPORTANT when first setting a master key on an install that already stored AI keys (they were sealed under
# CATCH_FERNET_KEY): copy the current CATCH_FERNET_KEY value into CATCH_SECRETS_MASTER_KEY_PREVIOUS below, or those
# keys become unreadable and have to be re-entered.
# Old master key(s), comma-separated, while rotating — keeps already-stored keys readable.
CATCH_SECRETS_MASTER_KEY_PREVIOUS=
# Ollama (a user-supplied URL the server will fetch). On for a personal install; a public deployment must set 0.
CATCH_OLLAMA_ENABLED=1

SYNC_INTERVAL_HOURS=2
BACKFILL_DAYS=30

# Mounts the MCP server's streamable-HTTP transport at /mcp/ (trailing slash required — see
# docs/mcp.md), for reaching the coach's tools over Tailscale without stdio. Off by default:
# the `mcp` package is only imported when this is "1", so a Pi that never uses it pays nothing.
# The stdio transport (catch-mcp, for Claude Desktop) doesn't need this — see docs/mcp.md.
CATCH_MCP_HTTP_ENABLED=0

# USDA FoodData Central API key (free, self-serve: https://fdc.nal.usda.gov/api-key-signup) —
# used as the nutrition barcode-lookup fallback when Open Food Facts has no match. Without
# this set, barcode lookups go straight from Open Food Facts to manual entry — see
# docs/nutrition-endpoints.md.
USDA_FDC_API_KEY=

# Web Push (session 16 — see PLAN.md Part A). Generate once with:
#   uv run python -c "
#   from py_vapid import Vapid02
#   from cryptography.hazmat.primitives.serialization import Encoding, PublicFormat
#   import base64
#   v = Vapid02(); v.generate_keys()
#   b64 = lambda b: base64.urlsafe_b64encode(b).rstrip(b'=').decode()
#   print('VAPID_PUBLIC_KEY=' + b64(v.public_key.public_bytes(Encoding.X962, PublicFormat.UncompressedPoint)))
#   print('VAPID_PRIVATE_KEY=' + b64(v.private_key.private_numbers().private_value.to_bytes(32, 'big')))
#   "
# Rotating these invalidates every existing push subscription (every installed device would
# need to re-subscribe) — generate once, keep it. VAPID_PUBLIC_KEY is not sensitive (the
# browser needs it to subscribe; catch/api/routes_push.py serves it at runtime, it's never
# baked into the built bundle). VAPID_SUBJECT must be a `mailto:you@example.com` or an
# `https://` origin with no path — push services use it to contact you if something's wrong
# with your server's requests.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Dead-man's-switch pings (session 16 — see PLAN.md Part B): free account at healthchecks.io,
# add two checks — "catch-sync" (period ~2h, grace ~1h) and "catch-backup" (period 1 day,
# grace ~6h) — and paste each check's own ping URL below. Left blank, both pings just no-op
# (catch/core/healthchecks.py / deploy/backup.sh) rather than erroring — fill in whenever
# convenient, nothing else depends on these being set.
HEALTHCHECKS_SYNC_URL=
HEALTHCHECKS_BACKUP_URL=

# Optional second ops-alert channel (session 16 Part B.3): a free https://ntfy.sh topic (pick
# any long, hard-to-guess name — anyone who knows it can read your alerts, it's not a secret
# key but treat it like one) or your own self-hosted ntfy server. Blank disables it; push
# notifications (Part A) are the primary channel regardless.
NTFY_TOPIC=

# Off-Pi backup copy (session 16 Part B.4, Pi deployment only — irrelevant locally).
# scp target for the nightly backup, e.g. ben@ben-macbook.tailnet.ts.net:/Users/ben/catch-
# backups/ (that directory must already exist on the laptop). Blank disables it — the local
# 14-backup rotation in /var/lib/catch/backups still runs regardless. See deploy/pi-
# bootstrap.sh's printed setup steps for the SSH key + Remote Login side of this.
BACKUP_SCP_TARGET=
